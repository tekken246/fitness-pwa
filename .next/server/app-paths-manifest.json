{
  "/manifest.webmanifest/route": "app/manifest.webmanifest/route.js",
  "/page": "app/page.js",
  "/sign-in/[[...sign-in]]/page": "app/sign-in/[[...sign-in]]/page.js",
  "/(app)/today/page": "app/(app)/today/page.js",
  "/(app)/workouts/page": "app/(app)/workouts/page.js",
  "/(app)/history/page": "app/(app)/history/page.js",
  "/(app)/workouts/[dayId]/page": "app/(app)/workouts/[dayId]/page.js"
}